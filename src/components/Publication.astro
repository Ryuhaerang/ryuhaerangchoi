---
import { authorWebsites, type Publication } from '../data/site';
import Icon from './Icon.astro';
interface Props { publication: Publication; }
const { publication } = Astro.props;
const thumbnail = publication.category === 'conference-journal' ? publication.thumbnail : undefined;
const authors = (publication.authors ?? '').split(/(, and |, | and )/).map(text => {
  const name = text.replace(/\*+$/, '');
  return { text, name, marker: text.slice(name.length), url: authorWebsites[name] };
});
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const citationYear = publication.category === 'preprint' && publication.venue === 'arXiv' ? undefined : publication.year;
const citation = [publication.venue, citationYear].filter(value => value !== undefined && value !== '').join(' ');
---
<article class:list={['publication', { 'publication-with-image': thumbnail }]} aria-labelledby={publication.id}>
  {thumbnail && <a class="publication-thumbnail" href={publication.links?.find(link => link.label === 'Project')?.url ?? publication.url} aria-label={`Learn more about ${publication.title}`}>
    <img src={`${base}${thumbnail.src}`} alt={thumbnail.alt} width={thumbnail.width} height={thumbnail.height} loading="lazy" decoding="async" />
  </a>}
  <div class="publication-body">
    {publication.award && <p class="award"><Icon name="trophy" /><span>{publication.award}</span></p>}
    <h4 id={publication.id}>{publication.url ? <a href={publication.url}>{publication.title}</a> : publication.title}</h4>
    {publication.authors && <p class="authors">{authors.map(author => author.name === 'Ryuhaerang Choi' ? <strong>{author.text}</strong> : author.url ? <><a class="author-link" href={author.url} title={`${author.name} — website`}>{author.name}</a>{author.marker}</> : author.text)}</p>}
    {(citation || publication.status) && <p class="venue">{citation}{publication.status && <span class="publication-status">{citation && ' · '}{publication.status}</span>}</p>}
    {(publication.url || publication.links?.length) && <div class="publication-links" aria-label={`Resources for ${publication.title}`}>
      {publication.url && <a href={publication.url}>Paper</a>}
      {publication.links?.map(link => <a href={link.url}>{link.label}</a>)}
    </div>}
  </div>
</article>
